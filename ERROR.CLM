-- ============================================================
-- TOGGLE FACTORY
-- ============================================================
local function makeToggle(parent, order, displayName, desc, stateKey, onChange)
    local btn = Instance.new("TextButton")
    btn.Name = "Toggle_" .. stateKey
    btn.Size = UDim2.new(1, 0, 0, 46)
    btn.BackgroundColor3 = Color3.fromRGB(13, 19, 15)
    btn.BackgroundTransparency = 0.15
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.LayoutOrder = order
    btn.ZIndex = 11
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Color3.fromRGB(35, 70, 43)
    stroke.Thickness = 1
    stroke.Transparency = 0.3

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -55, 0, 16)
    lbl.Position = UDim2.fromOffset(10, 6)
    lbl.BackgroundTransparency = 1
    lbl.Text = displayName
    lbl.TextColor3 = Color3.fromRGB(230, 240, 233)
    lbl.TextSize = 10
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 12
    lbl.Parent = btn

    local dsc = Instance.new("TextLabel")
    dsc.Size = UDim2.new(1, -55, 0, 12)
    dsc.Position = UDim2.fromOffset(10, 24)
    dsc.BackgroundTransparency = 1
    dsc.Text = desc
    dsc.TextColor3 = Color3.fromRGB(100, 125, 108)
    dsc.TextSize = 7
    dsc.Font = Enum.Font.Gotham
    dsc.TextXAlignment = Enum.TextXAlignment.Left
    dsc.TextTruncate = Enum.TextTruncate.AtEnd
    dsc.ZIndex = 12
    dsc.Parent = btn

    local swBg = Instance.new("Frame")
    swBg.Size = UDim2.fromOffset(34, 18)
    swBg.Position = UDim2.new(1, -42, 0.5, -9)
    swBg.BackgroundColor3 = Color3.fromRGB(32, 42, 35)
    swBg.ZIndex = 12
    swBg.Parent = btn
    Instance.new("UICorner", swBg).CornerRadius = UDim.new(1, 0)

    local swKnob = Instance.new("Frame")
    swKnob.Size = UDim2.fromOffset(12, 12)
    swKnob.Position = UDim2.new(0, 3, 0.5, -6)
    swKnob.BackgroundColor3 = Color3.fromRGB(145, 155, 148)
    swKnob.ZIndex = 13
    swKnob.Parent = swBg
    Instance.new("UICorner", swKnob).CornerRadius = UDim.new(1, 0)

    local function updateVisual(isOn)
        if isOn then
            TweenService:Create(swBg, TweenInfo.new(0.18), { BackgroundColor3 = Color3.fromRGB(30, 205, 90) }):Play()
            TweenService:Create(swKnob, TweenInfo.new(0.18), { Position = UDim2.new(1, -15, 0.5, -6), BackgroundColor3 = Color3.fromRGB(240, 255, 242) }):Play()
            stroke.Color = Color3.fromRGB(40, 190, 80)
        else
            TweenService:Create(swBg, TweenInfo.new(0.18), { BackgroundColor3 = Color3.fromRGB(32, 42, 35) }):Play()
            TweenService:Create(swKnob, TweenInfo.new(0.18), { Position = UDim2.new(0, 3, 0.5, -6), BackgroundColor3 = Color3.fromRGB(145, 155, 148) }):Play()
            stroke.Color = Color3.fromRGB(35, 70, 43)
        end
    end

    updateVisual(state[stateKey] == true)

    btn.MouseButton1Click:Connect(function()
        state[stateKey] = not state[stateKey]
        updateVisual(state[stateKey])
        if onChange then onChange(state[stateKey]) end
    end)

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(19, 28, 21) }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(13, 19, 15) }):Play()
    end)

    return { Button = btn, Set = updateVisual }
end

makeToggle(leftCol, 1, "AUTO STEAL", "Steals eggs from chickens automatically", "autoSteal")
makeToggle(leftCol, 2, "Auto Sell All", "Sells all items periodically", "autoSell")
makeToggle(leftCol, 3, "Auto Collect All", "Claims all eggs periodically", "autoCollect")
makeToggle(leftCol, 4, "Auto Press 1", "Spams key 1", "autoPress1")
makeToggle(leftCol, 5, "Low FPS Mode", "Optimize graphics", "lowFps", function(on)
    if on then
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.Brightness = 0
            Lighting.FogEnd = 9000000000
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
    end
end)

-- ============================================================
-- AREA SELECTION (all start OFF)
-- ============================================================
for i, zone in ipairs(ZONE_ORDER) do
    local btn = Instance.new("TextButton")
    btn.Name = "Area_" .. zone
    btn.Size = UDim2.new(1, 0, 0, 22)
    btn.BackgroundColor3 = Color3.fromRGB(20, 28, 22)
    btn.BackgroundTransparency = 0.2
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.LayoutOrder = i
    btn.ZIndex = 12
    btn.Parent = areaScroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Color3.fromRGB(30, 50, 35)
    stroke.Thickness = 1
    stroke.Transparency = 0.4

    local dot = Instance.new("Frame")
    dot.Size = UDim2.fromOffset(12, 12)
    dot.Position = UDim2.new(0, 6, 0.5, -6)
    dot.BackgroundColor3 = Color3.fromRGB(60, 70, 63)
    dot.BackgroundTransparency = 0.2
    dot.ZIndex = 13
    dot.Parent = btn
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -30, 1, 0)
    lbl.Position = UDim2.fromOffset(24, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = zone
    lbl.TextColor3 = Color3.fromRGB(120, 135, 124)
    lbl.TextSize = 10
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 13
    lbl.Parent = btn

    local function updateVisual(on)
        if on then
            dot.BackgroundColor3 = Color3.fromRGB(30, 205, 90)
            dot.BackgroundTransparency = 0
            lbl.TextColor3 = Color3.fromRGB(220, 235, 225)
            stroke.Color = Color3.fromRGB(40, 150, 80)
        else
            dot.BackgroundColor3 = Color3.fromRGB(60, 70, 63)
            dot.BackgroundTransparency = 0.2
            lbl.TextColor3 = Color3.fromRGB(120, 135, 124)
            stroke.Color = Color3.fromRGB(30, 50, 35)
        end
    end

    updateVisual(false)

    btn.MouseButton1Click:Connect(function()
        state.zones[zone] = not state.zones[zone]
        updateVisual(state.zones[zone])
    end)

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), { BackgroundColor3 = Color3.fromRGB(28, 38, 30) }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), { BackgroundColor3 = Color3.fromRGB(20, 28, 22) }):Play()
    end)
end

