task.spawn(function()
    local frames = 0
    local elapsed = 0
    RunService.RenderStepped:Connect(function(dt)
        frames += 1
        elapsed += dt
        if elapsed >= 0.5 then
            fpsLabel.Text = "FPS: " .. tostring(math.floor(frames / elapsed + 0.5))
            frames = 0
            elapsed = 0
        end
    end)
    while task.wait(1) do
        pcall(function()
            pingLabel.Text = "PING: " .. tostring(math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)) .. "ms"
        end)
    end
end)

-- ============================================================
-- OPTIMIZED AUTO STEAL
-- ============================================================
local function isAnyZoneEnabled()
    for _, v in pairs(state.zones) do
        if v then return true end
    end
    return false
end

local chickenCache = {}
local lastCacheUpdate = 0

local function updateChickenCache()
    local now = tick()
    if now - lastCacheUpdate < 0.4 then return end
    lastCacheUpdate = now
    
    chickenCache = {}
    local Game = Workspace:FindFirstChild("Game")
    if not Game then return end
    
    for _, d in ipairs(Game:GetDescendants()) do
        local n = d.Name:lower()
        if (n:match("chicken") or n:match("chick") or n:match("bird") or n:match("rooster") or n:match("hen"))
            and (d:IsA("Model") or d:IsA("BasePart")) then
            local pos = d:IsA("Model") and d:GetPivot().Position or d.Position
            if math.abs(pos.X) > 60 and pos.Y > 10 and pos.Y < 120 then
                for zoneName, enabled in pairs(state.zones) do
                    if enabled then
                        local r = ZONE_RANGES[zoneName]
                        if r and pos.X >= r[1] and pos.X <= r[2] then
                            table.insert(chickenCache, { part = d, pos = pos, zone = zoneName })
                            break
                        end
                    end
                end
            end
        end
    end
end

local function getClosestChicken()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    updateChickenCache()
    local closest = nil
    local closestDist = math.huge
    for _, c in ipairs(chickenCache) do
        if c.part and c.part.Parent then
            local dist = (c.pos - hrp.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closest = c
            end
        end
    end
    return closest
end

local promptCooldowns = {}

local function firePromptsNear(position, radius)
    radius = radius or 30
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled then
            local p = d.Parent
            local pp
            if p then
                if p:IsA("Model") then pp = p:GetPivot().Position
                elseif p:IsA("BasePart") then pp = p.Position
                elseif p:IsA("Attachment") and p.Parent then pp = p.Parent.Position end
            end
            if pp and (pp - position).Magnitude <= radius then
                local now = tick()
                if not promptCooldowns[d] or now - promptCooldowns[d] > 0.05 then
                    promptCooldowns[d] = now
                    pcall(function()
                        d.HoldDuration = 0
                        fireproximityprompt(d, 0)
                    end)
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.12)
        if state.autoSteal and isAnyZoneEnabled() then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local chicken = getClosestChicken()
                if chicken and chicken.part and chicken.part.Parent then
                    hrp.CFrame = CFrame.new(chicken.pos + Vector3.new(0, 4, 0))
                    firePromptsNear(chicken.pos, 30)
                    
                    pcall(function()
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                        task.wait(0.02)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                    end)
                    
                    pcall(function()
                        if chicken.part:IsA("Model") then
                            for _, c in ipairs(chicken.part:GetDescendants()) do
                                if c:IsA("BasePart") then
                                    firetouchinterest(hrp, c, 0)
                                    task.wait(0.005)
                                    firetouchinterest(hrp, c, 1)
                                end
                            end
                        elseif chicken.part:IsA("BasePart") then
                            firetouchinterest(hrp, chicken.part, 0)
                            task.wait(0.005)
                            firetouchinterest(hrp, chicken.part, 1)
                        end
                    end)
                    
                    if REMO then
                        pcall(function()
                            REMO["game.nests.stealEgg"]:InvokeServer(chicken.zone, chicken.pos, chicken.part)
                        end)
                    end
                    
                    pcall(function()
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
                        task.wait(0.02)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
                    end)
                    
                    task.wait(0.08)
                    if hrp and hrp.Parent then
                        hrp.CFrame = CFrame.new(CONFIG.SAFE_POS)
                    end
                    task.wait(0.1)
                else
                    task.wait(0.4)
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(2)
        if state.autoSell and REMO then
            pcall(function() REMO["data.backpack.sellAllItems"]:FireServer() end)
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(2)
        if state.autoCollect and REMO then
            pcall(function() REMO["data.base.claimAllEggs"]:FireServer() end)
