local jobRevealed = true
local jobVisible = true
local jobVisible2 = false

local function updateJobDisplay()
    jobIdLabel.Text = jobRevealed and (game.JobId ~= "" and game.JobId or str) or str
    jobShowBtn.Text = jobRevealed and "SHOW" or "HIDE"
    jobIcon.ImageRectOffset = jobRevealed and Vector2.new(724, 364) or Vector2.new(760, 364)
end

local function updateJobHideNames()
    if jobVisible then
        jobHideNamesBtn.Text = "HIDE NAMES ON"
        jobHideNamesBtn.BackgroundColor3 = color7
        jobHideNamesBtn.TextColor3 = color8
        jobHideNamesDot.BackgroundColor3 = color9
    else
        jobHideNamesBtn.Text = "HIDE NAMES OFF"
        jobHideNamesBtn.BackgroundColor3 = color10
        jobHideNamesBtn.TextColor3 = color11
        jobHideNamesDot.BackgroundColor3 = color12
    end
end

local function updateJobShowNum()
    if jobVisible2 then
        jobShowNumBtn.Text = "SHOW # ON"
        jobShowNumBtn.BackgroundColor3 = color7
        jobShowNumBtn.TextColor3 = color8
        jobShowNumDot.BackgroundColor3 = color9
    else
        jobShowNumBtn.Text = "SHOW # OFF"
        jobShowNumBtn.BackgroundColor3 = color10
        jobShowNumBtn.TextColor3 = color11
        jobShowNumDot.BackgroundColor3 = color12
    end
end

updateJobDisplay()
updateJobHideNames()
updateJobShowNum()

jobCopyBtn.MouseButton1Click:Connect(function()
    local jobId = game.JobId
    if setclipboard then setclipboard(jobId) end
    jobCopyBtn.Text = "COPIED"
    task.wait(1.1)
    jobCopyBtn.Text = "COPY"
end)

jobShowBtn.MouseButton1Click:Connect(function()
    jobRevealed = not jobRevealed
    updateJobDisplay()
end)

jobHideNamesBtn.MouseButton1Click:Connect(function()
    jobVisible = not jobVisible
    updateJobHideNames()
end)

jobShowNumBtn.MouseButton1Click:Connect(function()
    jobVisible2 = not jobVisible2
    updateJobShowNum()
end)

local jobDragging = false
local jobDragStart, jobStartPos, jobLastInput
jobFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        jobDragging = true
        jobDragStart = input.Position
        jobStartPos = jobFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then jobDragging = false end
        end)
    end
end)
jobFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        jobLastInput = input
    end
end)
RunService.RenderStepped:Connect(function()
    if jobDragging and jobLastInput then
        local delta = jobLastInput.Position - jobDragStart
        jobFrame.Position = UDim2.new(jobStartPos.X.Scale, jobStartPos.X.Offset + delta.X, jobStartPos.Y.Scale, jobStartPos.Y.Offset + delta.Y)
    end
end)

